{
  "name": "melo-gui",
  "version": "0.1.0",
  "private": true,
  "description": "MELO — desktop music player",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:backend": "cd .. && bun build --compile --target=bun-windows-x64 src/backend-headless.ts --outfile=gui/resources/backend-headless.exe",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package": "npm run build:backend && electron-vite build && electron-builder --win --config",
    "package:dir": "npm run build:backend && electron-vite build && electron-builder --win --dir --config"
  },
  "dependencies": {
    "lucide-react": "^1.37.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^35.5.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.melo.gui",
    "productName": "MELO",
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/backend-headless.exe",
        "to": "backend-headless.exe"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/tray.png",
        "to": "tray.png"
      }
    ]
  }
}
