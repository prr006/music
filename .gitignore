# Bundled MELO runtime binaries (never commit third-party executables)
lightweight/resources/bin/*.exe
lightweight/resources/bin/*.dll
lightweight/resources/bin/mpv/
lightweight/resources/.melo-runtime-fingerprint.json

# Windows reserved device
nul/